---
import SiteLayout from '@/layouts/SiteLayout.astro';
import PortableText from '@/components/PortableText.astro';
import ShareButtons from '@/components/interactive/ShareButtons.svelte';
import { client, urlFor } from '@/lib/sanity/astro-client';
import { POST_BY_SLUG_QUERY } from '@/lib/sanity/queries';
import type { Post } from '@/lib/sanity/types';
import { Image } from 'astro:assets';

const categoryLabels: Record<string, string> = {
  'your-website': 'Your Website',
  performance: 'Performance',
  'getting-found': 'Getting Found',
  cost: 'Cost & Value',
  process: 'Behind the Build',
};

const { slug } = Astro.params;
let post: Post | null = null;
if (client && slug) {
  try {
    post = await client.fetch<Post | null>(POST_BY_SLUG_QUERY, { slug });
  } catch {
    post = null;
  }
}

if (!post) Astro.response.status = 404;

const title = post?.metaTitle ?? post?.title ?? 'Guide not found';
const description = post?.excerpt ?? 'Guide not found.';
const canonical = slug ? `/knowledge/${slug}` : '/knowledge';
const postCoverImage = post?.coverImage;
const coverImageUrl = postCoverImage ? urlFor(postCoverImage).width(1200).height(675).auto('format').url() : undefined;
const ogImage = postCoverImage ? urlFor(postCoverImage).width(1200).height(630).auto('format').url() : '/og-image.png';
const formattedDate = post ? new Date(post.publishedAt).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) : '';

const structuredData = post && slug ? {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://brianwoodson.dev' },
        { '@type': 'ListItem', position: 2, name: 'Guides', item: 'https://brianwoodson.dev/knowledge' },
        { '@type': 'ListItem', position: 3, name: post.title, item: `https://brianwoodson.dev/knowledge/${slug}` },
      ],
    },
    {
      '@type': 'BlogPosting',
      headline: post.title,
      description: post.excerpt,
      datePublished: post.publishedAt,
      ...(post._updatedAt ? { dateModified: post._updatedAt } : {}),
      author: { '@type': 'Person', name: 'Brian Woodson', url: 'https://brianwoodson.dev/about' },
      publisher: { '@type': 'Organization', name: 'Brian Woodson Web Development', url: 'https://brianwoodson.dev' },
      mainEntityOfPage: `https://brianwoodson.dev/knowledge/${slug}`,
      ...(coverImageUrl ? { image: coverImageUrl } : {}),
    },
  ],
} : null;
---

<SiteLayout
  title={title}
  description={description}
  canonical={canonical}
  image={ogImage}
  noindex={!post}
  ogType="article"
  publishedTime={post?.publishedAt}
  modifiedTime={post?._updatedAt}
>
  {structuredData && <script slot="head" type="application/ld+json" set:html={JSON.stringify(structuredData)} />}

  {post ? (
    <main class="mx-auto w-full max-w-3xl px-6 py-24">
      <a href="/knowledge" class="mb-10 inline-flex items-center gap-1.5 text-sm text-text-muted transition-colors hover:text-text">← Guides</a>

      <header class="mb-14 space-y-6">
        <div class="flex items-center gap-2.5">
          <span class="rounded-full border border-border px-2.5 py-0.5 text-[10px] font-bold uppercase tracking-widest text-text-muted">{categoryLabels[post.category] ?? post.category}</span>
          <span class="text-[10px] text-text-muted-2">{post.readingTime} min read</span>
        </div>
        <h1 class="text-3xl font-extrabold leading-tight tracking-tight text-text md:text-5xl">{post.title}</h1>
        <p class="text-xl text-text-muted">{post.excerpt}</p>
        <div class="border-t border-border pt-4">
          <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
            <time class="text-sm text-text-muted-2" datetime={post.publishedAt}>{formattedDate}</time>
            <ShareButtons client:visible title={post.title} slug={slug!} type="knowledge" />
          </div>
        </div>
      </header>

      {coverImageUrl && (
        <div class="mb-14 aspect-video w-full overflow-hidden rounded-2xl border border-border">
          <Image src={coverImageUrl} alt={post.coverImage?.alt ?? post.title} width={1200} height={675} class="h-full w-full object-cover" priority={true} />
        </div>
      )}

      <article><PortableText value={post.body} /></article>
    </main>
  ) : (
    <main class="mx-auto w-full max-w-3xl px-6 py-32 text-center">
      <h1 class="text-4xl font-extrabold text-text">Guide not found</h1>
      <p class="mt-4 text-text-muted">The guide you're looking for doesn't exist.</p>
      <a href="/knowledge" class="mt-8 inline-flex rounded-full bg-text px-6 py-3 text-sm font-bold text-bg">View guides</a>
    </main>
  )}
</SiteLayout>
