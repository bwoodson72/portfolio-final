---
import SiteLayout from '@/layouts/SiteLayout.astro';
---

<SiteLayout title="Page Not Found | Brian Woodson Web Development" description="The requested page could not be found." canonical="/404" noindex={true}>
  <main class="mx-auto flex min-h-[60vh] w-full max-w-3xl flex-col items-center justify-center px-6 py-24 text-center space-y-6">
    <p class="text-xs font-bold uppercase tracking-widest text-text-muted">404</p>
    <h1 class="text-4xl font-extrabold tracking-tight text-text md:text-6xl">Page not found</h1>
    <p class="max-w-xl text-lg text-text-muted">The page you requested does not exist or has moved.</p>
    <a href="/" class="rounded-full bg-text px-8 py-4 text-sm font-bold text-bg transition hover:opacity-90">Back to homepage</a>
  </main>
</SiteLayout>
