---
import { faqs } from '@/content/portfolio';

const selectedQuestions = [
  'Do you write the copy?',
  'How does pricing work?',
  'How do revisions work?',
];

const items = selectedQuestions
  .map((question) => faqs.find((faq) => faq.question === question))
  .filter(Boolean);
---

<section class="mx-auto w-full max-w-3xl px-6 py-24">
  <div class="mb-10 space-y-4">
    <h2 class="text-2xl font-extrabold tracking-tight text-text md:text-4xl">
      Things people ask before they commit
    </h2>
    <p class="text-lg text-text-muted">
      Have more? <a href="/faq" class="underline transition-colors hover:text-text">Check out the full FAQ.</a>
    </p>
  </div>

  <ul class="space-y-3">
    {items.map((item) => item && (
      <li>
        <details class="group rounded-2xl border border-border bg-surface open:border-border-strong">
          <summary class="flex cursor-pointer list-none select-none items-center justify-between gap-4 px-6 py-5 text-sm font-bold text-text marker:content-none">
            {item.question}
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 text-text-muted transition-transform group-open:rotate-180" aria-hidden="true">
              <path d="m6 9 6 6 6-6" />
            </svg>
          </summary>
          <div class="border-t border-border px-6 py-5">
            <p class="text-sm leading-relaxed text-text-muted">{item.answer}</p>
          </div>
        </details>
      </li>
    ))}
  </ul>

  <div class="mt-8">
    <a href="/faq" class="inline-flex rounded-full border border-border px-6 py-3 text-sm font-bold text-text transition hover:border-border-strong">
      View all FAQs
    </a>
  </div>
</section>
