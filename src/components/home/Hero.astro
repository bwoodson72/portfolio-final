---
import { Image } from 'astro:assets';
import ConsultButton from '@/components/ConsultButton.astro';
import { siteContent } from '@/content/portfolio';
import heroBackground from '@/assets/bg-hero.avif';

const { hero } = siteContent;
---

<section id="top" class="relative flex h-dvh w-full flex-col items-center justify-center overflow-hidden px-6 py-24 text-center md:py-32">
  <Image
    src={heroBackground}
    alt=""
    widths={[640, 960, 1280, 1600, 1920]}
    sizes="100vw"
    priority
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 h-full w-full select-none object-cover brightness-40"
  />

  <div class="relative max-w-240 space-y-8">
    <h1 class="text-4xl font-extrabold tracking-tight text-text sm:text-6xl md:text-7xl">
      {hero.headline}
    </h1>
    <p class="mx-auto max-w-2xl text-lg leading-relaxed text-text-muted md:text-xl">
      {hero.subheadline}
    </p>
    <div class="flex flex-col items-center justify-center gap-4 sm:flex-row sm:gap-6">
      <ConsultButton />
      <a href="/services" class="rounded-full border border-border bg-surface px-8 py-4 text-sm font-bold text-text transition hover:bg-surface-hover">
        {hero.ctaSecondary}
      </a>
    </div>
  </div>
</section>
