---
import { FEATURED_PROJECTS_QUERY } from '@/lib/sanity/queries';
import type { ProjectCard } from '@/lib/sanity/types';
import { client } from '@/lib/sanity/astro-client';

let projects: ProjectCard[] = [];
if (client) {
  try {
    projects = await client.fetch<ProjectCard[]>(FEATURED_PROJECTS_QUERY);
  } catch {
    projects = [];
  }
}

const withQuotes = projects.filter((project) => project.highlightQuote);
---

{withQuotes.length > 0 && (
  <section class="mx-auto w-full max-w-7xl px-6 py-24">
    <div class="mb-12 space-y-4 text-center md:text-left">
      <h2 class="text-3xl font-extrabold tracking-tight text-text md:text-5xl">What We've Built</h2>
      <p class="max-w-2xl text-lg text-text-muted">Results from recent projects.</p>
    </div>

    <div class="grid gap-6 md:grid-cols-3">
      {withQuotes.map((project) => (
        <a href={`/work/${project.slug.current}`} class="flex flex-col rounded-2xl border border-border bg-surface p-8 transition hover:-translate-y-1 hover:border-border-strong">
          <p class="flex-1 text-sm leading-relaxed text-text-muted">{project.highlightQuote}</p>
          <div class="mt-6 border-t border-border pt-4">
            <span class="text-sm font-bold text-text">{project.title}</span>
          </div>
        </a>
      ))}
    </div>
  </section>
)}
