---
import { siteContent } from '@/content/portfolio';
import { testimonials } from '@/content/testimonials';
import TestimonialCard from '@/components/TestimonialCard.astro';

const { about } = siteContent;
const testimonial = testimonials[0];
---

<section id="about" class="mx-auto w-full max-w-7xl border-t border-border px-6 py-24">
  <div class="grid gap-12 lg:grid-cols-2">
    <div class="space-y-6">
      <h2 class="text-3xl font-extrabold tracking-tight text-text md:text-5xl">{about.headline}</h2>
      <div class="space-y-4 text-lg text-text-muted">
        {about.body.map((paragraph) => <p>{paragraph}</p>)}
      </div>
      <a href="/about" class="inline-block text-sm font-bold text-text underline-offset-4 hover:underline">More about us →</a>
    </div>

    <div class="space-y-6">
      {testimonial && <TestimonialCard testimonial={testimonial} />}
    </div>
  </div>
</section>
