---
import ConsultButton from '@/components/ConsultButton.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Ready to move forward?',
  description = "Book a consultation now. No obligation. No sales pitch. Let's see if we're a good fit together.",
} = Astro.props;
---

<section class="mx-auto w-full max-w-7xl border-t border-border px-6 py-24">
  <div class="space-y-6 rounded-3xl border border-border bg-surface p-12 text-center">
    <h2 class="text-3xl font-extrabold tracking-tight text-text md:text-4xl">{title}</h2>
    <p class="mx-auto max-w-xl text-lg text-text-muted">{description}</p>
    <div class="flex justify-center"><ConsultButton /></div>
  </div>
</section>
