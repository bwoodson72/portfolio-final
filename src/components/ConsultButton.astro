---
interface Props {
  label?: string;
  href?: string;
  class?: string;
}

const {
  label = 'Book a Consultation',
  href = '/contact',
  class: className = '',
} = Astro.props;
---

<a
  href={href}
  class:list={[
    'inline-flex max-w-fit items-center justify-center whitespace-nowrap rounded-full bg-accent px-8 py-4 text-center text-sm font-bold text-text transition hover:bg-accent-hover',
    className,
  ]}
  aria-label={label}
>
  {label}
</a>
