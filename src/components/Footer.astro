---
import { PHONE_ARIA_LABEL, PHONE_DISPLAY, PHONE_HREF } from '@/lib/constants';
import { ALL_LOCATION_CARDS_QUERY, ALL_SERVICE_CARDS_QUERY } from '@/lib/sanity/queries';
import type { LocationCard, ServiceCard } from '@/lib/sanity/types';
import { client } from '@/lib/sanity/astro-client';

let serviceCards: ServiceCard[] = [];
let locations: LocationCard[] = [];

if (client) {
  try {
    [serviceCards, locations] = await Promise.all([
      client.fetch<ServiceCard[]>(ALL_SERVICE_CARDS_QUERY),
      client.fetch<LocationCard[]>(ALL_LOCATION_CARDS_QUERY),
    ]);
  } catch {
    serviceCards = [];
    locations = [];
  }
}

const year = new Date().getFullYear();
---

<footer class="w-full border-t border-border bg-bg">
  <div class="mx-auto max-w-7xl px-6 py-16">
    <div class="grid grid-cols-1 gap-12 text-center md:grid-cols-4">
      <div class="space-y-4">
        <h3 class="text-xs font-bold uppercase tracking-widest text-text">Services</h3>
        <ul class="space-y-2 text-sm text-text-muted">
          {serviceCards.map((service) => (
            <li><a href={`/services/${service.slug.current}`} class="transition-colors hover:text-text">{service.title}</a></li>
          ))}
        </ul>
      </div>

      <div class="space-y-4">
        <h3 class="text-xs font-bold uppercase tracking-widest text-text">Links</h3>
        <ul class="space-y-2 text-sm text-text-muted">
          <li><a href="/services" class="transition-colors hover:text-text">Services</a></li>
          <li><a href="/faq" class="transition-colors hover:text-text">FAQ</a></li>
          <li><a href="/contact" class="transition-colors hover:text-text">Email</a></li>
          <li><a href="/privacy" class="transition-colors hover:text-text">Privacy Policy</a></li>
          <li><a href="/terms" class="transition-colors hover:text-text">Terms of Service</a></li>
          <li><a href={PHONE_HREF} aria-label={PHONE_ARIA_LABEL} class="transition-colors hover:text-text">{PHONE_DISPLAY}</a></li>
        </ul>
      </div>

      <div class="space-y-4">
        <h3 class="text-xs font-bold uppercase tracking-widest text-text">Locations</h3>
        <ul class="space-y-2 text-sm text-text-muted">
          {locations.map((location) => (
            <li><a href={`/locations/${location.slug}`} class="transition-colors hover:text-text">{location.city}</a></li>
          ))}
        </ul>
      </div>

      <div class="space-y-4">
        <h3 class="text-xs font-bold uppercase tracking-widest text-text">Brian Woodson Web Development</h3>
        <p class="text-sm leading-relaxed text-text-muted">We build websites for small businesses that get found on Google and bring in customers.</p>
      </div>
    </div>

    <div class="mt-16 flex flex-col items-center justify-between gap-4 border-t border-border pt-8 text-[10px] font-bold uppercase tracking-widest text-text-muted md:flex-row">
      <div>© {year} Brian Woodson Web Development. All rights reserved.</div>
      <a href="#top" class="transition-colors hover:text-text">Back to top</a>
    </div>
  </div>
</footer>
