---
import { toHTML } from '@portabletext/to-html';

interface Props {
  value?: unknown[] | null;
}

const { value } = Astro.props;
const html = value?.length ? toHTML(value as never[], { onMissingComponent: false }) : '';
---

{html && <div class="portable-text" set:html={html} />}

<style is:global>
  .portable-text p { margin-bottom: 1.5rem; color: var(--color-text-muted); line-height: 2; }
  .portable-text h2 { margin-top: 3.5rem; margin-bottom: 1.25rem; border-bottom: 1px solid var(--color-border); padding-bottom: .75rem; font-size: 1.5rem; font-weight: 800; color: var(--color-text); }
  .portable-text h3 { margin-top: 2.5rem; margin-bottom: 1rem; font-size: 1.25rem; font-weight: 700; color: var(--color-text); }
  .portable-text h4 { margin-top: 2rem; margin-bottom: .75rem; font-weight: 700; color: var(--color-text); }
  .portable-text blockquote { margin: 2rem 0; border-left: 2px solid var(--color-border-strong); padding-left: 1.5rem; font-style: italic; color: var(--color-text-muted); }
  .portable-text ul { margin-bottom: 1.5rem; list-style: disc; padding-left: 1.5rem; color: var(--color-text-muted); }
  .portable-text ol { margin-bottom: 1.5rem; list-style: decimal; padding-left: 1.5rem; color: var(--color-text-muted); }
  .portable-text li { margin-bottom: .5rem; line-height: 1.75; }
  .portable-text strong { color: var(--color-text); font-weight: 700; }
  .portable-text a { text-decoration: underline; text-underline-offset: 4px; }
  .portable-text code { border: 1px solid var(--color-border); border-radius: .375rem; background: var(--color-surface-hover); padding: .125rem .375rem; font-family: var(--font-mono); font-size: .875rem; }
</style>
