{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    },
    "allowJs": true,
    "skipLibCheck": true,
    "jsx": "preserve",
    "jsxImportSource": "react"
  },
  "include": [
    ".astro/types.d.ts",
    "**/*.astro",
    "**/*.ts",
    "**/*.tsx",
    "**/*.svelte",
    "**/*.mts"
  ],
  "exclude": ["node_modules", "dist"]
}
